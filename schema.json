{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDISON Data Miner Ingestion Schema",
  "version": "1.0.0",
  "description": "Master schema for scanned/ingested documents in the EDISON local database (divorce + custody trial, FC2025-094908, Maricopa County Superior Court; plus pending Arizona Chapter 7 bankruptcy). Every field the Data Miner cannot read from a source document MUST be written as the literal string MISSING_DATA -- never estimated, guessed, or inferred.",
  "global_rules": [
    "NEVER estimate, average, round, or infer any date, amount, or identity.",
    "If a value is not explicitly present in the source document, set it to the string MISSING_DATA.",
    "Every record must carry full provenance (see provenance block) so a human can trace it back to the physical/scanned original.",
    "Dollar amounts are stored as strings in the source's exact format (e.g. \"$1,234.56\") in *_raw fields, and as numeric cents only when unambiguous (no OCR uncertainty) in *_cents fields; if uncertain, *_cents = null and a note is added to extraction_flags.",
    "Every person reference uses the entity_id from the taxonomy file (taxonomy.json), never a free-text name.",
    "Case period tags (pre_marriage / marriage / post_separation / post_petition / post_temp_order) are computed only from dates explicitly confirmed in /projects/.../areas/edison-database.md or case_anchors.json -- never guessed from context."
  ],
  "type": "object",
  "required": [
    "record_id",
    "provenance",
    "record_type",
    "entity_tags",
    "extraction"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "description": "UUIDv4 generated by Data Miner at ingestion time."
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_file_name",
        "source_file_sha256",
        "source_path",
        "ingested_at",
        "page_or_line_ref",
        "verbatim_extract"
      ],
      "properties": {
        "source_file_name": {
          "type": "string"
        },
        "source_file_sha256": {
          "type": "string",
          "description": "SHA-256 hash of the exact source file as scanned."
        },
        "source_path": {
          "type": "string",
          "description": "Original path/location the file was found or scanned from (e.g. USB drive path, email attachment, folder name) -- for chain-of-custody, not for display."
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time"
        },
        "page_or_line_ref": {
          "type": "string",
          "description": "e.g. 'p.3' or 'line 14' or 'exhibit 7 of 12'."
        },
        "verbatim_extract": {
          "type": "string",
          "description": "Exact OCR/extracted text the parsed fields below were derived from, unmodified."
        },
        "ocr_confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "extraction_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. ['amount_illegible', 'date_ambiguous_mm_dd', 'page_missing']"
        }
      }
    },
    "record_type": {
      "type": "string",
      "enum": [
        "court_filing",
        "court_order",
        "court_calendar_event",
        "financial_transaction",
        "financial_statement",
        "financial_account_doc",
        "medical_event",
        "medical_record",
        "medical_bill",
        "eob",
        "claim_denial",
        "parenting_event",
        "communication",
        "photo_evidence",
        "video_evidence",
        "insurance_document",
        "employment_document",
        "tax_document",
        "criminal_case_document",
        "protective_order_document",
        "bankruptcy_document",
        "correspondence",
        "other"
      ]
    },
    "case_association": {
      "type": "object",
      "properties": {
        "case_number": {
          "type": "string",
          "description": "Court case number exactly as printed (e.g. FC2025-094908, CR2001-093849, a JC2024...-style Justice Court number, a 10-digit Mesa eCourt number), or 'N/A' / 'MISSING_DATA'. Not enforced as an enum: cases discovered by the court watcher must be storable."
        },
        "court": {
          "type": "string",
          "description": "e.g. 'Maricopa County Superior Court', 'East Mesa Justice Court'"
        },
        "case_period_tag": {
          "type": "string",
          "enum": [
            "pre_marriage",
            "marriage",
            "post_separation",
            "post_petition",
            "post_temp_order",
            "MISSING_DATA"
          ],
          "description": "Computed ONLY from confirmed case_anchors.json dates. If any anchor date is itself MISSING_DATA, this field must be MISSING_DATA."
        }
      }
    },
    "entity_tags": {
      "description": "Who this record concerns. Use entity_id values from taxonomy.json ONLY. Two accepted shapes: the flat list the edison-miner Modelfile is trained to emit (e.g. [\"john_switzer\"]), or the structured object. An empty list is allowed and is flagged entity_tags_empty by run_miner.py.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "required": [
            "primary_subjects"
          ],
          "properties": {
            "primary_subjects": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "entity_id(s) the record is directly about (e.g. whose medical bill, whose expense)."
            },
            "mentioned": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "entity_id(s) referenced but not the primary subject."
            },
            "payer_entity_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "scheduler_entity_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "attendee_entity_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "dates": {
      "type": "object",
      "properties": {
        "event_date": {
          "type": "string",
          "description": "ISO 8601 (YYYY-MM-DD) or MISSING_DATA if not explicit in source."
        },
        "document_date": {
          "type": "string"
        },
        "date_confidence": {
          "type": "string",
          "enum": [
            "exact",
            "approximate_from_context",
            "MISSING_DATA"
          ]
        }
      }
    },
    "financial": {
      "type": "object",
      "description": "Populate only for record_type in [financial_transaction, financial_statement, financial_account_doc, medical_bill, eob].",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Reference to accounts.json entity_id, or MISSING_DATA."
        },
        "account_owner_entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "institution_name": {
          "type": "string"
        },
        "account_last4": {
          "type": "string",
          "pattern": "^([0-9]{4}|MISSING_DATA)$"
        },
        "transaction_date": {
          "type": "string"
        },
        "amount_raw": {
          "type": "string",
          "description": "Exact string as printed, e.g. '$482.10' or '($482.10)' for debit."
        },
        "amount_cents": {
          "type": [
            "integer",
            "null"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "debit",
            "credit",
            "MISSING_DATA"
          ]
        },
        "payee_or_payor": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "Preferred vocabulary: child_expense, marital_debt, separate_debt, income, support_payment, legal_fee, medical, housing, transportation, other, MISSING_DATA. Not enforced as an enum: the miner emits descriptive labels (e.g. sobriety_monitoring, court_fines) and rejecting a whole record over a label loses evidence. Query by merchant_raw / flags, not category."
        },
        "disputed_issue_tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. ['child_support', 'property_division', 'dissipation'] -- only if user has designated disputed issues; otherwise empty array."
        },
        "reimbursement_requested": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "MISSING_DATA"
          ]
        },
        "reimbursement_received": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "partial",
            "MISSING_DATA"
          ]
        }
      }
    },
    "medical": {
      "type": "object",
      "description": "Populate only for record_type in [medical_event, medical_record, medical_bill, eob, claim_denial].",
      "properties": {
        "patient_entity_id": {
          "type": "string"
        },
        "provider_name": {
          "type": "string"
        },
        "provider_type": {
          "type": "string",
          "enum": [
            "medical",
            "dental",
            "vision",
            "therapy_counseling",
            "psychiatric",
            "medication_management",
            "specialist",
            "speech_ot_pt",
            "assessment",
            "other",
            "MISSING_DATA"
          ]
        },
        "clinician_name": {
          "type": "string"
        },
        "treatment_description": {
          "type": "string"
        },
        "insurance_plan": {
          "type": "string"
        },
        "policyholder_entity_id": {
          "type": "string"
        },
        "eob_claim_number": {
          "type": "string"
        },
        "claim_status": {
          "type": "string",
          "enum": [
            "paid",
            "denied",
            "pending",
            "MISSING_DATA"
          ]
        },
        "scheduled_by_entity_id": {
          "type": "string"
        },
        "attended_by_entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paid_by_entity_id": {
          "type": "string"
        },
        "provider_recommendation": {
          "type": "string"
        },
        "recommendation_followed": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "partial",
            "MISSING_DATA"
          ]
        }
      }
    },
    "custody_evidence": {
      "type": "object",
      "description": "Populate only for record_type in [parenting_event, communication, photo_evidence, video_evidence].",
      "properties": {
        "event_subtype": {
          "type": "string",
          "enum": [
            "scheduled_exchange",
            "late_exchange",
            "missed_exchange",
            "cancellation",
            "schedule_change",
            "school_event",
            "activity",
            "supervised_visit",
            "protective_order_related",
            "soberlink_result",
            "other",
            "MISSING_DATA"
          ]
        },
        "scheduled_start": {
          "type": "string"
        },
        "actual_start": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "source_platform": {
          "type": "string",
          "enum": [
            "OFW_OurFamilyWizard",
            "text",
            "email",
            "photo",
            "calendar_export",
            "agency_report",
            "court_advisor_report",
            "other",
            "MISSING_DATA"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "entity_id list"
        },
        "narrative_summary": {
          "type": "string",
          "description": "Objective, verbatim-derived summary only -- no interpretation."
        }
      }
    },
    "handling": {
      "type": "object",
      "properties": {
        "bates_number": {
          "type": "string"
        },
        "redaction_applied": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "MISSING_DATA"
          ]
        },
        "original_retained": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "MISSING_DATA"
          ]
        },
        "attorney_reviewed": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "MISSING_DATA"
          ]
        }
      }
    },
    "extraction": {
      "type": "object",
      "required": [
        "extracted_by",
        "extraction_timestamp",
        "schema_version"
      ],
      "properties": {
        "extracted_by": {
          "type": "string",
          "description": "e.g. 'DataMinerAI-v1'"
        },
        "extraction_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "human_verified": {
          "type": "boolean",
          "default": false
        },
        "human_verified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vector_index": {
      "type": "object",
      "description": "Populated by the Qdrant ingestion pipeline, not the Data Miner directly.",
      "properties": {
        "chunk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embedding_model": {
          "type": "string"
        }
      }
    }
  }
}

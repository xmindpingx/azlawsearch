# copy to .env
CW_PIN=change-me            # PIN for the web page (LAN only by design)
PORT=8095
TZ=America/Phoenix
WATCH_TIMES=06:00,12:00,18:00
WATCH_ME=Last,First,MM/DD/YYYY,Middle   # optional: the person marked "me" (only matters with EDISON_EXPORT=1)
WATCH_POWERBI_URL=          # optional published Power BI report to capture each run
WATCH_DISABLED_SITES=       # e.g. powerbi,chandler,mcso
EDISON_EXPORT=0             # 1 = also push "me" rows into an EDISON stack (edison.db + Qdrant)
